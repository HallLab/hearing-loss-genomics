#!/bin/bash
#
# Phase 4, step 2 -- the gene burden association tests.
#
#   3 cohorts x 22 chromosomes = 66 tasks
#
# ONE CALL PER TASK COVERS THE WHOLE GRID (premise P10). SAIGE takes a list for
# --annotation_in_groupTest and for --maxMAF_in_groupTest, so each call tests
# 3 annotations x 3 MAF cutoffs internally and emits one Cauchy row per gene
# combining all nine. That row is the headline p-value, produced by the tool
# rather than computed afterwards.
#
# The replication sliced the same grid into 594 jobs and the pipeline it
# replicates into 792, which is why neither produced a per-gene omnibus.
# Measured on chr21 before switching: pLOF:pDM and pLOF are identical either
# way, pDM differs for 27% of genes because of label precedence, and SAIGE's
# native Cauchy matches the hand-computed ACAT for 165 of 208 genes with a
# median ratio of 1.000. See PREMISES.md P10.
#
# Genotypes: the 438 GB of per-chromosome exome plinks are the one path that
# points outside this folder -- a mechanical conversion of the release that
# encodes no decision. See PROVENANCE.md.
#
#BSUB -J s2_bilat[1-66]
#BSUB -q epistasis_normal
#BSUB -o /project/hall/analysis/hearing-loss-genomics/analysis/exwas_pmbb_bilateral/phase_4/logs/step2.%J.%I.out
#BSUB -e /project/hall/analysis/hearing-loss-genomics/analysis/exwas_pmbb_bilateral/phase_4/logs/step2.%J.%I.err
#BSUB -M 96000
#BSUB -R "rusage[mem=96000]"
#BSUB -n 4
#BSUB -W 24:00

set -euo pipefail
module load apptainer/1.4.1

SIF=/project/hall/tools/saige/1.5.0/saige_1.5.0.sif
RSCRIPT=/app/.pixi/envs/default/bin/Rscript
BASE=/project/hall/analysis/hearing-loss-genomics/analysis/exwas_pmbb_bilateral
ELENA=/project/hall/analysis/hearing-loss-genomics/analysis/elena

STEP1=${BASE}/phase_4/results/step1
MASKDIR=${BASE}/phase_4/data/masks_by_chrom/pLOF_pDM
PLINKDIR=${ELENA}/rarevariant_geneburden/plink_deduplicated
OUT=${BASE}/phase_4/results/step2

COHORTS=(combined EUR AFR)

# 66 = 3 cohorts x 22 chromosomes
J=$(( LSB_JOBINDEX - 1 ))
CHR=$(( J % 22 + 1 ))
GROUP=${COHORTS[$(( J / 22 ))]}

PLINK=${PLINKDIR}/chr${CHR}_deduplicated
GROUPFILE=${MASKDIR}/chr${CHR}.txt
MODEL=${STEP1}/${GROUP}/${GROUP}.rda
VARRATIO=${STEP1}/${GROUP}/${GROUP}.varianceRatio.txt.varianceRatio.txt

mkdir -p ${OUT}/${GROUP}
RESULT=${OUT}/${GROUP}/${GROUP}_chr${CHR}.txt

echo "task ${LSB_JOBINDEX}/66 : ${GROUP} chr${CHR}"
echo "  genes in group file: $(( $(wc -l < ${GROUPFILE}) / 2 ))"
echo "  start: $(date)"

for F in ${PLINK}.bed ${GROUPFILE} ${MODEL} ${VARRATIO}; do
  [[ -s ${F} ]] || { echo "MISSING INPUT: ${F}" >&2; exit 1; }
done

apptainer exec -B /project -B /project/hall -B /static ${SIF} ${RSCRIPT} \
  /usr/local/bin/step2_SPAtests.R \
  --bedFile=${PLINK}.bed \
  --bimFile=${PLINK}.bim \
  --famFile=${PLINK}.fam \
  --chrom=${CHR} \
  --GMMATmodelFile=${MODEL} \
  --varianceRatioFile=${VARRATIO} \
  --groupFile=${GROUPFILE} \
  --SAIGEOutputFile=${RESULT} \
  --minMAF=0 \
  --maxMAF_in_groupTest=0.0001,0.001,0.01 \
  --minMAC=1 \
  --annotation_in_groupTest="pLOF,pDM,pLOF:pDM" \
  --LOCO=FALSE \
  --is_Firth_beta=TRUE \
  --is_single_in_groupTest=FALSE \
  --is_output_moreDetails=TRUE \
  --is_no_weight_in_groupTest=TRUE \
  --is_overwrite_output=TRUE

echo "  done : $(date)"
ls -lh ${RESULT}*
