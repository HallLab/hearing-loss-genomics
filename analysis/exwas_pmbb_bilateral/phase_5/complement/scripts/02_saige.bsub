#!/bin/bash
# Complement run -- step 1 (task 1) then step 2 (tasks 2-23), combined cohort.
# Submitted as two arrays; this file is step 1.
#BSUB -J comp1
#BSUB -q epistasis_normal
#BSUB -o /project/hall/analysis/hearing-loss-genomics/analysis/exwas_pmbb_bilateral/phase_5/complement/logs/s1.%J.out
#BSUB -e /project/hall/analysis/hearing-loss-genomics/analysis/exwas_pmbb_bilateral/phase_5/complement/logs/s1.%J.err
#BSUB -M 64000
#BSUB -R "rusage[mem=64000]"
#BSUB -n 8
#BSUB -W 12:00
set -euo pipefail
module load apptainer/1.4.1
SIF=/project/hall/tools/saige/1.5.0/saige_1.5.0.sif
BASE=/project/hall/analysis/hearing-loss-genomics/analysis/exwas_pmbb_bilateral
C=${BASE}/phase_5/complement
mkdir -p ${C}/results/step1
apptainer exec -B /project -B /project/hall -B /static ${SIF} \
  /app/.pixi/envs/default/bin/Rscript /usr/local/bin/step1_fitNULLGLMM.R \
  --plinkFile=${BASE}/phase_3/data/pca/ALL.common_ldpruned \
  --phenoFile=${C}/data/complement.txt \
  --phenoCol=PHENO --covarColList=AGE,AGE2,SEX,Batch,PC1,PC2,PC3,PC4,PC5 \
  --qCovarColList=SEX,Batch --sampleIDColinphenoFile=IID --traitType=binary \
  --outputPrefix=${C}/results/step1/complement \
  --outputPrefix_varRatio=${C}/results/step1/complement.varianceRatio.txt \
  --IsOverwriteVarianceRatioFile=TRUE --nThreads=8
