#!/bin/bash
# Power control, step 1 -- one null model per replicate. Combined cohort only.
#BSUB -J pc1[1-5]
#BSUB -q epistasis_normal
#BSUB -o /project/hall/analysis/hearing-loss-genomics/analysis/exwas_pmbb_bilateral/phase_5/power_control/logs/s1.%J.%I.out
#BSUB -e /project/hall/analysis/hearing-loss-genomics/analysis/exwas_pmbb_bilateral/phase_5/power_control/logs/s1.%J.%I.err
#BSUB -M 64000
#BSUB -R "rusage[mem=64000]"
#BSUB -n 8
#BSUB -W 12:00
set -euo pipefail
module load apptainer/1.4.1
SIF=/project/hall/tools/saige/1.5.0/saige_1.5.0.sif
BASE=/project/hall/analysis/hearing-loss-genomics/analysis/exwas_pmbb_bilateral
PC=${BASE}/phase_5/power_control
R=${LSB_JOBINDEX}
mkdir -p ${PC}/results/step1/rep${R}
apptainer exec -B /project -B /project/hall -B /static ${SIF} \
  /app/.pixi/envs/default/bin/Rscript /usr/local/bin/step1_fitNULLGLMM.R \
  --plinkFile=${BASE}/phase_3/data/pca/ALL.common_ldpruned \
  --phenoFile=${PC}/data/rep${R}.txt \
  --phenoCol=PHENO --covarColList=AGE,AGE2,SEX,Batch,PC1,PC2,PC3,PC4,PC5 \
  --qCovarColList=SEX,Batch --sampleIDColinphenoFile=IID --traitType=binary \
  --outputPrefix=${PC}/results/step1/rep${R}/rep${R} \
  --outputPrefix_varRatio=${PC}/results/step1/rep${R}/rep${R}.varianceRatio.txt \
  --IsOverwriteVarianceRatioFile=TRUE --nThreads=8
