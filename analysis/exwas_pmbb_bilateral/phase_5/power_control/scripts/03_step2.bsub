#!/bin/bash
#BSUB -J pc_s2[1-330]
#BSUB -q epistasis_normal
#BSUB -n 4
#BSUB -M 64000
#BSUB -R "select[mem>=64000] rusage[mem=64000]"
#BSUB -W 4:00
#BSUB -o /project/hall/analysis/hearing-loss-genomics/analysis/exwas_pmbb_bilateral/phase_5/power_control/logs/s2.%J.%I.out
#BSUB -e /project/hall/analysis/hearing-loss-genomics/analysis/exwas_pmbb_bilateral/phase_5/power_control/logs/s2.%J.%I.err
#
# Power control, step 2 -- 3 cohorts x 5 draws x 22 chromosomes = 330 tasks.
# Identical settings to the main arm: single variant, minMAF 0.01, no group file.
#
set -euo pipefail
module load apptainer/1.4.1
SIF=/project/hall/tools/saige/1.5.0/saige_1.5.0.sif
RSCRIPT=/app/.pixi/envs/default/bin/Rscript
PC=/project/hall/analysis/hearing-loss-genomics/analysis/exwas_pmbb_bilateral/phase_5/power_control
GENO=/project/hall/analysis/hearing-loss-genomics/analysis/elena/rarevariant_geneburden/plink_deduplicated
OUT=${PC}/results/step2

COHORTS=(combined EUR AFR)
I=$(( LSB_JOBINDEX - 1 ))
COHORT=${COHORTS[$(( I / 110 ))]}
DRAW=$(( (I / 22) % 5 + 1 ))
CHR=$(( I % 22 + 1 ))
TAG=${COHORT}_draw${DRAW}

PLINK=${GENO}/chr${CHR}_deduplicated
MODEL=${PC}/results/step1/${TAG}/${TAG}.rda
VARRATIO=${PC}/results/step1/${TAG}/${TAG}.varianceRatio.txt.varianceRatio.txt
RESULT=${OUT}/${TAG}/${TAG}_chr${CHR}.txt

for F in ${PLINK}.bed ${MODEL} ${VARRATIO}; do
  [ -s "${F}" ] || { echo "MISSING: ${F}" >&2; exit 1; }
done
mkdir -p ${OUT}/${TAG}

apptainer exec -B /project -B /static ${SIF} ${RSCRIPT} \
  /usr/local/bin/step2_SPAtests.R \
  --bedFile=${PLINK}.bed --bimFile=${PLINK}.bim --famFile=${PLINK}.fam \
  --chrom=${CHR} \
  --GMMATmodelFile=${MODEL} \
  --varianceRatioFile=${VARRATIO} \
  --SAIGEOutputFile=${RESULT} \
  --minMAF=0.01 --minMAC=1 --LOCO=FALSE \
  --is_Firth_beta=TRUE --is_output_moreDetails=TRUE --is_overwrite_output=TRUE

GOT=$(( $(wc -l < ${RESULT}) - 1 ))
[ "${GOT}" -gt 0 ] || { echo "REFUSING: ${TAG} chr${CHR} tested nothing" >&2; exit 1; }
echo "${TAG} chr${CHR}: ${GOT} variants"
