#!/bin/bash
#BSUB -J hl_exwas[1-132]
#BSUB -q epistasis_normal
#BSUB -n 4
#BSUB -M 64000
#BSUB -R "select[mem>=64000] rusage[mem=64000]"
#BSUB -W 8:00
#BSUB -o /project/hall/analysis/hearing-loss-genomics/analysis/pmbb_hl/exwas/phase_4/logs/s2.%J.%I.out
#BSUB -e /project/hall/analysis/hearing-loss-genomics/analysis/pmbb_hl/exwas/phase_4/logs/s2.%J.%I.err
#
# ExWAS phase 4 -- single variant, MAF >= 0.01. 2 phenotypes x 3 cohorts x 22 chr.
#
# THERE IS NO STEP 1 HERE. The null model is fitted to the phenotype, the covariates and
# the relatedness, none of which depend on the variant filter -- so the six models the
# burden arm fitted are reused exactly. Refitting would reproduce the same numbers at the
# cost of the relatedness computation. The original PMBB v4 run did the same: its
# saige_hearing_pipeline.config points step1_outdir at the rare-variant run's output.
#
# PCs ARE THEREFORE THE SAME 11 / 15 / 16 the burden arm used, from the release's exome
# PCA at 80% of the variance.
#
# WHAT IS ABSENT, AND WHY. No --groupFile, so SAIGE runs in single-variant mode -- that
# flag's absence is what selects it, nothing else. No --maxMAF_in_groupTest: the MAF grid
# belongs to the burden arm and a single floor replaces it. No --annotation_in_groupTest:
# annotation decides nothing about what is tested here, since every variant is tested on
# its own whatever its consequence class.
#
# ON --minMAF AND --minMAC. SAIGE uses "the higher threshold between minMAC and minMAF".
# At minMAF=0.01 the implied MAC is ~1,150 in combined and ~227 in AFR, so minMAF always
# binds and minMAC=1 does nothing. Kept for fidelity to the original's min_mac = 1.
#
set -euo pipefail
module load apptainer/1.4.1
SIF=/project/hall/tools/saige/1.5.0/saige_1.5.0.sif
RSCRIPT=/app/.pixi/envs/default/bin/Rscript
P=/project/hall/analysis/hearing-loss-genomics/analysis/pmbb_hl/exwas/phase_4
BURDEN=/project/hall/analysis/hearing-loss-genomics/analysis/pmbb_hl/rare_variant
GENO=/project/hall/analysis/hearing-loss-genomics/analysis/elena/rarevariant_geneburden/plink_deduplicated
STEP1=${BURDEN}/phase_4/results/step1
OUT=${P}/results/step2

PHENOS=(broad bilateral)
COHORTS=(combined EUR AFR)
I=$(( LSB_JOBINDEX - 1 ))
PHENO=${PHENOS[$(( I / 66 ))]}
COHORT=${COHORTS[$(( (I / 22) % 3 ))]}
CHR=$(( I % 22 + 1 ))
TAG=${PHENO}_${COHORT}

PLINK=${GENO}/chr${CHR}_deduplicated
MODEL=${STEP1}/${TAG}/${TAG}.rda
VARRATIO=${STEP1}/${TAG}/${TAG}.varianceRatio.txt
RESULT=${OUT}/${TAG}/${TAG}_chr${CHR}.txt

for F in ${PLINK}.bed ${MODEL} ${VARRATIO}; do
  [ -s "${F}" ] || { echo "MISSING: ${F}" >&2; exit 1; }
done
mkdir -p ${OUT}/${TAG}

echo "task ${LSB_JOBINDEX}/132 -- ${TAG} chr${CHR}"
apptainer exec -B /project -B /static ${SIF} ${RSCRIPT} \
  /usr/local/bin/step2_SPAtests.R \
  --bedFile=${PLINK}.bed --bimFile=${PLINK}.bim --famFile=${PLINK}.fam \
  --chrom=${CHR} \
  --GMMATmodelFile=${MODEL} \
  --varianceRatioFile=${VARRATIO} \
  --SAIGEOutputFile=${RESULT} \
  --minMAF=0.01 --minMAC=1 --LOCO=FALSE \
  --is_Firth_beta=TRUE --is_output_moreDetails=TRUE --is_overwrite_output=TRUE

# The plink2 census is an UPPER BOUND, not an equality: plink2 divides by observed
# genotypes and SAIGE by the whole cohort, so a variant with missingness can clear 1%
# for one and not the other. The reverse is impossible.
HIST=${P}/../phase_2/results/census/${TAG}.chr${CHR}.afreq.alt1.bins
GOT=$(( $(wc -l < ${RESULT}) - 1 ))
[ "${GOT}" -gt 0 ] || { echo "REFUSING: ${TAG} chr${CHR} tested nothing" >&2; exit 1; }
if [ -s "${HIST}" ]; then
  CEIL=$(awk 'NR>1 && ($1=="0.01"||$1=="0.05"||$1=="0.95") {s+=$2} END {print s+0}' ${HIST})
  SHORT=$(( CEIL - GOT ))
  echo "rows: ${GOT}   plink2 ceiling: ${CEIL}   shortfall: ${SHORT}"
  [ "${SHORT}" -ge 0 ] || { echo "REFUSING: tested ${GOT}, above the ceiling ${CEIL}" >&2; exit 1; }
  [ "${SHORT}" -le $(( CEIL / 200 )) ] || { echo "REFUSING: shortfall ${SHORT} exceeds 0.5%" >&2; exit 1; }
fi
echo "${TAG} chr${CHR}: ${GOT} variants"
