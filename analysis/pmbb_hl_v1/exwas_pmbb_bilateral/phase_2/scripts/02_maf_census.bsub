#!/bin/bash
#BSUB -J maf_census_bil[1-66]
#BSUB -q epistasis_normal
#BSUB -n 4
#BSUB -M 24000
#BSUB -R "select[mem>=24000] rusage[mem=24000]"
#BSUB -W 2:00
#BSUB -o /project/hall/analysis/hearing-loss-genomics/analysis/exwas_pmbb_bilateral/phase_2/logs/census.%J.%I.out
#BSUB -e /project/hall/analysis/hearing-loss-genomics/analysis/exwas_pmbb_bilateral/phase_2/logs/census.%J.%I.err
#
# Phase 2 -- MAF census, 3 cohorts x 22 chromosomes = 66 tasks.
#
# WHY THIS EXISTS
# The secondary significance bar is 0.05 / n_variants_tested (premise P6), and
# n_variants_tested is not knowable from the .bim: it depends on who is in the
# cohort, because MAF is a property of the sample set. This counts it, per cohort,
# BEFORE step 2 runs -- so the bar is fixed before any p-value is visible.
#
# WHAT IT WRITES
# A histogram, not a per-variant file. plink2 can only compress output with zstd,
# and this environment has neither the zstd CLI nor python's zstandard module, so a
# per-variant file would be written in a format nothing downstream can read. The
# histogram boundaries are placed at every threshold this project might ever want
# (the three burden MAF cutoffs, 0.05, and the 1% bar itself), which means another
# threshold is a recount of these files rather than a re-read of 600 GB of genotypes.
#
# ON THE MIRROR BINS
# plink2 reports ALT1 frequency, which is not MAF: an ALT allele at 0.995 has
# MAF 0.005. So MAF >= 0.01 is ALT1 frequency in [0.01, 0.99], and the bins above
# 0.95 are included to measure that rather than assume REF is always major. The
# chr21 smoke test found them empty, which is the expected result and not a reason
# to stop reporting them.
#
set -euo pipefail

PLINK2=/appl/plink2-20240804/plink2
BASE=/project/hall/analysis/hearing-loss-genomics/analysis/exwas_pmbb_bilateral
GENO=/project/hall/analysis/hearing-loss-genomics/analysis/elena/rarevariant_geneburden/plink_deduplicated
OUT=${BASE}/phase_2/results/census

# COHORTS, not GROUPS: GROUPS is a bash special variable holding unix GIDs, and
# ${GROUPS[2]} silently returns a group id instead of a cohort name.
COHORTS=(combined EUR AFR)

I=$(( LSB_JOBINDEX - 1 ))
COHORT=${COHORTS[$(( I / 22 ))]}
CHR=$(( I % 22 + 1 ))

KEEP=${BASE}/phase_2/data/${COHORT}.keep
BFILE=${GENO}/chr${CHR}_deduplicated
STEM=${OUT}/${COHORT}.chr${CHR}

for F in ${KEEP} ${BFILE}.bed ${BFILE}.bim ${BFILE}.fam; do
  [ -s "${F}" ] || { echo "MISSING or EMPTY: ${F}" >&2; exit 1; }
done

mkdir -p ${OUT}
echo "===================================="
echo "MAF census -- bilateral sensorineural hearing loss"
echo "task   : ${LSB_JOBINDEX}/66"
echo "cohort : ${COHORT}  ($(wc -l < ${KEEP}) samples kept)"
echo "chrom  : ${CHR}     ($(wc -l < ${BFILE}.bim) variants on file)"
echo "start  : $(date)"
echo "===================================="

${PLINK2} \
  --bfile ${BFILE} \
  --keep ${KEEP} \
  --freq bins-only alt1bins=0.0001,0.001,0.01,0.05,0.95,0.99,0.999,0.9999 \
  --out ${STEM} \
  --threads 4 --memory 20000

# The histogram must account for every variant on the file. If it does not, the
# frequency pass saw a different variant set than the .bim and the count is wrong.
HIST=${STEM}.afreq.alt1.bins
[ -s "${HIST}" ] || { echo "plink2 wrote no histogram: ${HIST}" >&2; exit 1; }
SUM=$(awk 'NR>1 {s+=$2} END {print s+0}' ${HIST})
BIM=$(wc -l < ${BFILE}.bim)
if [ "${SUM}" -ne "${BIM}" ]; then
  echo "REFUSING: histogram sums to ${SUM}, .bim has ${BIM} variants" >&2
  exit 1
fi

echo "${COHORT} chr${CHR}: ${SUM} variants binned, matches .bim"
cat ${HIST}
echo "done : $(date)"
