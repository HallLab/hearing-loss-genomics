#!/bin/bash
#BSUB -J pcx_s2[1-44]
#BSUB -q epistasis_normal
#BSUB -n 4
#BSUB -M 64000
#BSUB -R "select[mem>=64000] rusage[mem=64000]"
#BSUB -W 4:00
#BSUB -o /project/hall/analysis/hearing-loss-genomics/analysis/pc_choice/logs/s2.%J.%I.out
#BSUB -e /project/hall/analysis/hearing-loss-genomics/analysis/pc_choice/logs/s2.%J.%I.err
#
# PC choice experiment, step 2 -- 2 arms x 22 chromosomes.
# Single-variant, identical settings to the main ExWAS arm. Single variant is used
# rather than gene burden because lambda is only a clean diagnostic there: the burden
# arm's omnibus is Cauchy-combined, which deflates lambda to 0.68-0.84 throughout and
# makes it useless as a readout.
#
set -euo pipefail
module load apptainer/1.4.1
SIF=/project/hall/tools/saige/1.5.0/saige_1.5.0.sif
RSCRIPT=/app/.pixi/envs/default/bin/Rscript
PC=/project/hall/analysis/hearing-loss-genomics/analysis/pc_choice
GENO=/project/hall/analysis/hearing-loss-genomics/analysis/elena/rarevariant_geneburden/plink_deduplicated
OUT=${PC}/results/step2

ARMS=(A_exome10 B_imputed9)
I=$(( LSB_JOBINDEX - 1 ))
ARM=${ARMS[$(( I / 22 ))]}
CHR=$(( I % 22 + 1 ))

PLINK=${GENO}/chr${CHR}_deduplicated
MODEL=${PC}/results/step1/${ARM}/${ARM}.rda
VARRATIO=${PC}/results/step1/${ARM}/${ARM}.varianceRatio.txt.varianceRatio.txt
RESULT=${OUT}/${ARM}/${ARM}_chr${CHR}.txt

for F in ${PLINK}.bed ${MODEL} ${VARRATIO}; do
  [ -s "${F}" ] || { echo "MISSING: ${F}" >&2; exit 1; }
done
mkdir -p ${OUT}/${ARM}

apptainer exec -B /project -B /static ${SIF} ${RSCRIPT} \
  /usr/local/bin/step2_SPAtests.R \
  --bedFile=${PLINK}.bed --bimFile=${PLINK}.bim --famFile=${PLINK}.fam \
  --chrom=${CHR} \
  --GMMATmodelFile=${MODEL} \
  --varianceRatioFile=${VARRATIO} \
  --SAIGEOutputFile=${RESULT} \
  --minMAF=0.01 --minMAC=1 --LOCO=FALSE \
  --is_Firth_beta=TRUE --is_output_moreDetails=TRUE --is_overwrite_output=TRUE

GOT=$(( $(wc -l < ${RESULT}) - 1 ))
[ "${GOT}" -gt 0 ] || { echo "REFUSING: ${ARM} chr${CHR} tested nothing" >&2; exit 1; }
echo "${ARM} chr${CHR}: ${GOT} variants"
